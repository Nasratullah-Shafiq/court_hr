<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_employee_position_report" model="ir.actions.report">
            <field name="name">Print Employee Report</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">egp_hr.print_employee_id</field>
            <field name="report_file">egp_hr.print_employee_id</field>
            <field name="print_report_name">'Employee Biography - %s' % (object.name).replace('/', '')</field>
            <field name="binding_model_id" ref="model_hr_employee"/>
            <field name="paperformat_id" ref="egp_hr.report_paperformat_a4"/>
            <field name="binding_type">report</field>
        </record>


        <template id="print_employee_id">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="doc">
                        <div class="page" style="font-family:Calibri;">
                            <div class="row">
                                <div class="col-6 text-center">
                                    <p>امارت اسلامی افغانستان</p>

                                    <p t-esc="env.user.company_id.name"/>
                                </div>

                                <div class="col-6 text-center">
                                    <p>د افغانستان اسلامی امارت</p>
                                    <p t-esc="env.user.company_id.name"/>
                                </div>
                            </div>
                            <div class="row" style="margin-top:15px;">

                                <div class="col-2" style="padding-right: 0px;">
                                    <img src="egp_hr/static/description/Emerate_logo.png"
                                         height="120" border="1" width="120"
                                         style="margin-right: 0px; margin-top: 50px;"/>
                                </div>

                                <div class="col-8 text-center">
                                    <p>Islamic Emarat of Afghanistan</p>
                                    <p t-esc="env.user.company_id.name"/>
                                    <p>د کارکونکو چارو ریاست</p>
                                    <p>د سوانح آمریت</p>
                                </div>

                                <div class="col-2"
                                     style="
                                        margin: 0;
                                        padding: 0;
                                        text-align: right;
                                     ">

                                    <t t-if="doc.create_uid.company_id.logo">
                                        <img t-att-src="'data:image/png;base64,' + doc.create_uid.company_id.logo.decode('utf-8')"
                                             alt="Company Logo"
                                             width="150"
                                             height="180"
                                             style="
                                                margin: 0;
                                                padding: 0;
                                                margin-top: 30px;
                                             "/>
                                    </t>

                                    <t t-else="">
                                        <img src="/egp_hr/static/description/MCIT_logo.png"
                                             height="150"
                                             width="180"
                                             border="1"
                                             style="
                                                margin: 0;
                                                padding: 0;
                                             "/>
                                    </t>

                                </div>

                            </div>
                            <div class="row" style="font-family:Calibri;">
                                <div class="col-11">
                                    Number:
                                    <div t-if="doc.barcode" t-field="doc.barcode"
                                         t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'max-height:50pt;max-width:100%;', 'img_align': 'center'}">
                                        12345678901
                                    </div>
                                    <br/>
                                    <p>Date:
                                        <span t-field="doc.today_date"/>
                                    </p>
                                </div>
                                <div class="col-1" style="margin-bottom: 15px;">
                                    <img t-att-src="image_data_uri(doc.avatar_1920)"
                                         style="max-height:100pt;max-width:100%"
                                         alt="Employee Image"/>
                                </div>
                            </div>
                            <div class="col-12" style="font-family:Calibri; padding-bottom: 15px;">
                                Civil service employee report form to complete the records for the purpose of
                                appointment in new duties, conversion, dismissal and re-appointment
                            </div>
                            <table class="table table-bordered"
                                   style="font-family:Calibri; width:100%; border-collapse:collapse;">

                                <tr style="text-align: left;">
                                    <th>Name</th>
                                    <th>Father Name</th>
                                    <th>Grand Father Name</th>
                                    <th>Date of Birth</th>
                                    <th>Place of Birth</th>
                                    <th>ID Card No</th>
                                </tr>
                                <tr>
                                    <td>
                                        <span t-field="doc.name"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.father_name"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.grand_father_name"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.emp_date_of_birth"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.emp_place_of_birth"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.identification_no"/>
                                    </td>

                                </tr>
                            </table>
                            <div style="padding-bottom: 15px; font-weight: bold;">Information about education and higher
                                education
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>
                                    <th>Field of Study</th>
                                    <th>Degree</th>
                                    <th>University</th>
                                    <th>Education Place</th>
                                    <th>Start Date</th>
                                    <th>Graduation Date</th>
                                </tr>

                                <t t-foreach="doc.modern_education_ids" t-as="emp">
                                    <tr>
                                        <td>
                                            <span t-field="emp.faculty_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.degree_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.university_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.country_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.education_start_date"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.education_end_date"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                            <div style="font-family:Calibri; padding-top: 5px; padding-bottom: 15px; font-weight: bold;">
                                Address and
                                Contacts
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>
                                    <th>Address</th>
                                    <th>Email</th>
                                    <th>Phone No</th>
                                </tr>
                                <tr>
                                    <td>
                                        <span t-field="doc.temporary_province"/>,
                                        <span t-field="doc.temporary_district"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.work_email"/>
                                    </td>
                                    <td>
                                        <span t-field="doc.private_phone"/>
                                    </td>
                                </tr>
                            </table>
                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">Work Experiences
                                related to the job
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>
                                    <th>Organization</th>
                                    <th>Job Position</th>
                                    <th>Grade</th>
                                    <th>Step</th>
                                    <th>Job Location</th>
                                    <th>Department</th>
                                    <th>Status</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                    <th>Duration</th>
                                </tr>
                                <t t-foreach="doc.experience_ids" t-as="emp">
                                    <tr>
                                        <td>
                                            <span t-field="emp.organization_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.job_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.grade_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.step_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.department"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.status_id.name"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.organization_type"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.job_start_date"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.job_end_date"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.duration_human_readable"/>
                                        </td>
                                    </tr>
                                </t>
                                <!--                                <t t-foreach="doc.experience_ids" t-as="emp">-->
                                <!--                                    <tr>-->
                                <!--                                        <td>-->
                                <!--                                            <span t-field="emp.organization_id.name"/>-->
                                <!--                                        </td>-->
