                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">Training
                                courses
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>
                                    <th>Course</th>
                                    <th>Training Type</th>
                                    <th>Training Location</th>
                                    <th>Certification</th>
                                    <th>Result</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>
                                </tr>
                                <t t-foreach="doc.training_ids" t-as="emp">
                                    <tr>
                                        <td>
                                            <span t-field="emp.course_id.name"/>
                                        </td>

                                        <td class="text-center">
                                            <span t-field="emp.training_type"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.training_location"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="emp.training_certification"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.training_result"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.training_start_date"/>
                                        </td>

                                        <td>
                                            <span t-field="emp.training_end_date"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">Language Skills
                            </div>

                            <table class="table table-bordered" style="font-family:Calibri;">
                                <thead>
                                    <tr>
                                        <th>Language</th>
                                        <th>Reading</th>
                                        <th>Speaking</th>
                                        <th>Listening</th>
                                        <th>Writing</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <t t-foreach="doc.language_ids" t-as="emp">
                                        <tr>
                                            <td>
                                                <span t-field="emp.language_id.name"/>
                                            </td>
                                            <td>
                                                <span t-field="emp.reading"/>
                                            </td>
                                            <td>
                                                <span t-field="emp.speaking"/>
                                            </td>
                                            <td>
                                                <span t-field="emp.listening"/>
                                            </td>
                                            <td>
                                                <span t-field="emp.writing"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">Publication
                                (Book, Magazine ... )
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri; border: 1px; solid black;">
                                <tr>
                                    <th>Publication Type</th>
                                    <th>Subject</th>
                                    <th>Publish Date</th>
                                    <th>No of Pages</th>
                                    <th>ISBN</th>
                                </tr>
                                <t t-foreach="doc.publication_ids" t-as="emp">
                                    <tr>
