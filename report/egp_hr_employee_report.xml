                                <!--                                        <td>-->
                                <!--                                            <span t-field="emp.job_end_date"/>-->
                                <!--                                        </td>-->
                                <!--                                        <td>-->
                                <!--                                            <span t-field="emp.job_start_date"/>-->
                                <!--                                        </td>-->
                                <!--                                        <td>-->
                                <!--                                            <span t-field="emp.duration_human_readable"/>-->
                                <!--                                        </td>-->
                                <!--                                    </tr>-->
                                <!--                                </t>-->
                            </table>
                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">Performance
                                evaluation information
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>
                                    <th>Evaluation Date</th>
                                    <th>Evaluation Type (Annual)</th>
                                    <th>Evaluation Score</th>
                                    <th>Final Result</th>
                                </tr>
                                <t t-foreach="doc.appraisal_ids" t-as="emp">
                                    <tr>
                                        <td>
                                            <span t-field="emp.appraisal_date"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.appraisal_type"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.total_marks"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.final_result"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">
                                Employee Reward Information
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>
                                    <th>Reward Type</th>
                                    <th>Reason</th>
                                    <th>Date of Issue</th>
                                    <th>No of Sentence</th>
                                </tr>
                                <t t-foreach="doc.reward_ids" t-as="emp">
                                    <tr>
                                        <td>
                                            <span t-field="emp.reward_type"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.reason"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.order_date"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.order_no"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                            <div style="font-family:Calibri; padding-bottom: 15px; font-weight: bold;">
                                Employee Punishment Information
                            </div>
                            <table class="table table-bordered" style="font-family:Calibri;">
                                <tr>

                                    <th>Punishment Type</th>
                                    <th>Violation Type</th>
                                    <th>Order</th>
                                    <th>Date</th>
                                    <th>Start Date</th>
                                    <th>End Date</th>

                                </tr>
                                <t t-foreach="doc.reward_ids" t-as="emp">
                                    <tr>
                                        <td>
                                            <span t-field="emp.punishment_type"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.violation_type"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.order"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.punishment_date"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.punishment_start_date"/>
                                        </td>
                                        <td>
                                            <span t-field="emp.punishment_end_date"/>
                                        </td>

                                    </tr>
                                </t>
                            </table>
                            <!--                            <div style="font-family:Calibri; padding-bottom: 15px;">-->
